{
  "name": "md-vscode",
  "displayName": "md",
  "description": "Markdown preview with math, chemistry, charts and diagrams: KaTeX, Mermaid, Graphviz, PlantUML and a built-in plotter, all on-device with nothing sent anywhere. Exports to HTML, PDF, EPUB, LaTeX and SVG.",
  "version": "1.5.0",
  "publisher": "nettrash",
  "license": "MIT",
  "author": {
    "name": "nettrash",
    "email": "nettrash@nettrash.me"
  },
  "homepage": "https://nettrash.me",
  "repository": {
    "type": "git",
    "url": "https://github.com/nettrash/md.vscode.git"
  },
  "bugs": {
    "url": "https://github.com/nettrash/md.vscode/issues"
  },
  "icon": "media/icon.png",
  "galleryBanner": {
    "color": "#2B221C",
    "theme": "dark"
  },
  "categories": [
    "Programming Languages",
    "Visualization",
    "Formatters"
  ],
  "keywords": [
    "markdown",
    "preview",
    "math",
    "chart",
    "plot",
    "diagram",
    "export",
    "pdf",
    "epub",
    "latex",
    "katex",
    "mermaid",
    "plantuml",
    "graphviz"
  ],
  "engines": {
    "vscode": "^1.95.0"
  },
  "main": "./dist/extension.js",
  "contributes": {
    "markdown.markdownItPlugins": true,
    "markdown.previewScripts": [
      "./media/preview/md-preview.js"
    ],
    "markdown.previewStyles": [
      "./media/preview/md-preview.css",
      "./media/rich/katex.min.css"
    ],
    "languages": [
      {
        "id": "markdown",
        "extensions": [
          ".mkdn",
          ".mkdown"
        ]
      },
      {
        "id": "plantuml",
        "aliases": [
          "PlantUML",
          "plantuml"
        ],
        "extensions": [
          ".puml",
          ".plantuml",
          ".iuml",
          ".pu"
        ],
        "configuration": "./language/plantuml.language-configuration.json"
      },
      {
        "id": "graphviz",
        "aliases": [
          "Graphviz",
          "DOT",
          "graphviz"
        ],
        "extensions": [
          ".gv",
          ".dot"
        ],
        "configuration": "./language/graphviz.language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "plantuml",
        "scopeName": "source.plantuml",
        "path": "./language/plantuml.tmLanguage.json"
      },
      {
        "language": "graphviz",
        "scopeName": "source.graphviz",
        "path": "./language/graphviz.tmLanguage.json"
      },
      {
        "scopeName": "markdown.md.codeblock",
        "path": "./language/markdown-md-codeblock.tmLanguage.json",
        "injectTo": [
          "text.html.markdown"
        ],
        "embeddedLanguages": {
          "meta.embedded.block.plantuml": "plantuml",
          "meta.embedded.block.graphviz": "graphviz",
          "meta.embedded.block.mermaid": "mermaid",
          "meta.embedded.block.latex": "latex"
        }
      }
    ],
    "commands": [
      {
        "command": "md.exportHtml",
        "title": "Export as HTML…",
        "category": "md"
      },
      {
        "command": "md.exportPdf",
        "title": "Export as PDF…",
        "category": "md"
      },
      {
        "command": "md.exportEpub",
        "title": "Export as EPUB…",
        "category": "md"
      },
      {
        "command": "md.exportLatex",
        "title": "Export as LaTeX…",
        "category": "md"
      },
      {
        "command": "md.exportSvg",
        "title": "Export Diagram as SVG…",
        "category": "md"
      },
      {
        "command": "md.showDiagramPreview",
        "title": "Preview Diagram",
        "category": "md"
      }
    ],
    "submenus": [
      {
        "id": "md.export",
        "label": "md: Export"
      }
    ],
    "menus": {
      "md.export": [
        {
          "command": "md.exportHtml",
          "group": "md@1"
        },
        {
          "command": "md.exportPdf",
          "when": "!listMultiSelection",
          "group": "md@2"
        },
        {
          "command": "md.exportEpub",
          "group": "md@3"
        },
        {
          "command": "md.exportLatex",
          "group": "md@4"
        }
      ],
      "explorer/context": [
        {
          "submenu": "md.export",
          "when": "resourceLangId == markdown",
          "group": "md@1"
        },
        {
          "command": "md.exportSvg",
          "when": "(resourceLangId == plantuml || resourceLangId == graphviz) && !listMultiSelection",
          "group": "md@2"
        },
        {
          "command": "md.showDiagramPreview",
          "when": "(resourceLangId == plantuml || resourceLangId == graphviz) && !listMultiSelection",
          "group": "md@3"
        }
      ],
      "editor/context": [
        {
          "submenu": "md.export",
          "when": "editorLangId == markdown",
          "group": "md@1"
        },
        {
          "command": "md.exportSvg",
          "when": "editorLangId == plantuml || editorLangId == graphviz",
          "group": "md@2"
        },
        {
          "command": "md.showDiagramPreview",
          "when": "editorLangId == plantuml || editorLangId == graphviz",
          "group": "md@3"
        }
      ],
      "editor/title/context": [
        {
          "submenu": "md.export",
          "when": "resourceLangId == markdown",
          "group": "md@1"
        },
        {
          "command": "md.exportSvg",
          "when": "resourceLangId == plantuml || resourceLangId == graphviz",
          "group": "md@2"
        },
        {
          "command": "md.showDiagramPreview",
          "when": "resourceLangId == plantuml || resourceLangId == graphviz",
          "group": "md@3"
        }
      ],
      "commandPalette": [
        {
          "command": "md.exportHtml",
          "when": "editorLangId == markdown"
        },
        {
          "command": "md.exportPdf",
          "when": "editorLangId == markdown"
        },
        {
          "command": "md.exportEpub",
          "when": "editorLangId == markdown"
        },
        {
          "command": "md.exportLatex",
          "when": "editorLangId == markdown"
        },
        {
          "command": "md.exportSvg",
          "when": "editorLangId == markdown || editorLangId == plantuml || editorLangId == graphviz"
        },
        {
          "command": "md.showDiagramPreview",
          "when": "editorLangId == plantuml || editorLangId == graphviz"
        }
      ],
      "editor/title": [
        {
          "command": "md.showDiagramPreview",
          "when": "editorLangId == plantuml || editorLangId == graphviz",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "md",
      "properties": {
        "md.preview.theme": {
          "type": "string",
          "enum": [
            "paper",
            "editor"
          ],
          "enumDescriptions": [
            "md's own typewriter look — fresh paper in a light theme, carbon paper in a dark one, set in American Typewriter with Courier New for code. Matches the iOS, macOS and Android apps.",
            "Look like the rest of VS Code: the colours of the current colour theme, and the fonts, size and line height of the built-in Markdown preview, including your markdown.preview.fontFamily, fontSize and lineHeight."
          ],
          "default": "editor",
          "description": "Which colours and fonts the preview draws in.",
          "scope": "resource"
        },
        "md.preview.bodyFont": {
          "type": "string",
          "default": "",
          "markdownDescription": "Font stack for preview prose. Leave empty to follow `#md.preview.theme#` — the built-in preview's own face in the editor theme, American Typewriter (falling back to Georgia, as the Android app does) in the paper theme.",
          "scope": "resource"
        },
        "md.preview.codeFont": {
          "type": "string",
          "default": "",
          "markdownDescription": "Font stack for code blocks and inline code in the preview. Leave empty to follow `#md.preview.theme#` — your `#editor.fontFamily#` in the editor theme, Courier New in the paper theme.",
          "scope": "resource"
        },
        "md.math.enabled": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Typeset `$…$`, `$$…$$` and ` ```math ` blocks with KaTeX, including `\\ce{…}` chemistry via mhchem.",
          "scope": "resource"
        },
        "md.diagrams.mermaid": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Render ` ```mermaid ` blocks.",
          "scope": "resource"
        },
        "md.diagrams.graphviz": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Render ` ```dot `, ` ```graphviz `, ` ```gv ` and the layout-named fences (`neato`, `circo`, `fdp`, `sfdp`, `twopi`, `osage`, `patchwork`).",
          "scope": "resource"
        },
        "md.diagrams.plantuml": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Render ` ```plantuml ` and ` ```puml ` blocks.",
          "scope": "resource"
        },
        "md.diagrams.plot": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Draw ` ```plot ` blocks as charts. Nothing is loaded either way — the renderer is built in — so switching this off only leaves the source visible.",
          "scope": "resource"
        },
        "md.highlight.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Syntax-highlight fenced code blocks that name a language.",
          "scope": "resource"
        },
        "md.export.pageSize": {
          "type": "string",
          "enum": [
            "A4",
            "A5",
            "Letter",
            "Legal",
            "6x9",
            "5x8",
            "5.5x8.5"
          ],
          "default": "A4",
          "description": "Page size for PDF export and print, including the print-on-demand trim sizes.",
          "scope": "resource"
        },
        "md.lint.dialect": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Point out, in the Problems pane and as a faint underline, the places where md's deliberate subset of Markdown renders a document differently from GitHub or a CommonMark engine. Every one of them is reported at **Information** level and never higher: the Markdown is not wrong, it will simply look different here. Switch the individual rules off with `#md.lint.rules#`.",
          "scope": "resource"
        },
        "md.lint.rules": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "rawHtml": {
              "type": "boolean",
              "default": true,
              "description": "Raw HTML tags. md escapes them, so <b> appears as those three characters instead of turning the next word bold."
            },
            "referenceLink": {
              "type": "boolean",
              "default": true,
              "description": "Reference-style links. md has none: the [text][label] and the [label]: url line are both printed as written."
            },
            "indentedCode": {
              "type": "boolean",
              "default": true,
              "description": "Four-space indented code. md has no indented code block, so the lines become a paragraph and lose their indentation and monospaced type."
            },
            "tableAfterParagraph": {
              "type": "boolean",
              "default": true,
              "description": "A table written directly under a paragraph. md needs a blank line above a table; without one the rows stay part of the paragraph."
            },
            "footnote": {
              "type": "boolean",
              "default": true,
              "description": "A footnote definition nothing cites. md prints the note at the foot of the document anyway, with no number in the text and no link back to it, where a CommonMark engine prints nothing at all."
            }
          },
          "default": {
            "rawHtml": true,
            "referenceLink": true,
            "indentedCode": true,
            "tableAfterParagraph": true,
            "footnote": true
          },
          "markdownDescription": "Which dialect differences `#md.lint.dialect#` reports. Each is on unless it is set to `false`.",
          "scope": "resource"
        }
      }
    }
  },
  "activationEvents": [
    "onLanguage:markdown",
    "onLanguage:plantuml",
    "onLanguage:graphviz"
  ],
  "scripts": {
    "compile": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "package": "npm run typecheck && npm run test && npm run compile && node scripts/package.mjs",
    "publish:vsix": "node scripts/publish.mjs",
    "vscode:prepublish": "node scripts/prepublish.mjs"
  },
  "devDependencies": {
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^22.10.2",
    "@types/vscode": "^1.95.0",
    "@vscode/vsce": "^3.2.1",
    "esbuild": "^0.24.2",
    "ovsx": "^0.10.12",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
